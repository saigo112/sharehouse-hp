# 環境変数テンプレート
# このファイルを .env.local にコピーして値を設定してください
# $ cp .env.local.example .env.local

# --- microCMS 設定 ---
# microCMSのサービスドメイン（例: kv5amlkshc）
# ALDEL FARMとアルデルハウスで同じPublic CMSを使用します。
MICROCMS_SHAREHOUSE_SERVICE_DOMAIN=

# microCMSのコンテンツAPIキー（microCMS管理画面 > API設定 > APIキーから確認）
MICROCMS_SHAREHOUSE_API_KEY=

# 旧環境変数も後方互換のため読み込みます。新規設定では上記の2項目を使用してください。
# MICROCMS_SERVICE_DOMAIN=
# MICROCMS_API_KEY=

# --- エントリーフォーム ---
# Googleフォームなどのエントリーフォームの公開URL
# microCMSから管理する場合はこの変数は不要（microCMS側のentryFormUrlフィールドが優先される）
NEXT_PUBLIC_ENTRY_FORM_URL=https://forms.gle/K6DDGNf2BxNEGZLH9

# --- Site URL ---
# デプロイ先のHTTPS URL。OGPなどの絶対URL生成に使用します（末尾の / は不要）。
NEXT_PUBLIC_SITE_URL=

# --- ALDEL FARM 日程確認・LINE相談 ---
# LINE公式アカウントのベーシックID（@から始まるID）
NEXT_PUBLIC_LINE_OFFICIAL_ID=

# LINE公式アカウントの友だち追加URL
NEXT_PUBLIC_LINE_OFFICIAL_URL=

# 公開用に作成したGoogleカレンダーの埋め込みURL
NEXT_PUBLIC_GOOGLE_CALENDAR_EMBED_URL=
